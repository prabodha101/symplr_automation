{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data-driven Playwright page validation data",
  "type": "object",
  "required": [
    "testCases"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseUrl": {
          "type": "string"
        },
        "navigationTimeout": {
          "type": "number"
        },
        "softAssertions": {
          "type": "boolean"
        }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "validationTemplates": {
      "type": "object",
      "description": "Parameterized validation definitions. Reuse them with {$template, params} in testCases, validationSets, or action validations.",
      "additionalProperties": {
        "$ref": "#/$defs/validationTemplateDefinition"
      }
    },
    "validationSets": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/validationOrReusable"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/$defs/validationOrReusable"
            }
          }
        ]
      }
    },
    "testCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/pageCase"
      }
    }
  },
  "$defs": {
    "pageCase": {
      "type": "object",
      "required": [
        "name",
        "validations"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "scenario": {
          "type": "string",
          "enum": [
            "prompt",
            "template",
            "figma",
            "existingApp"
          ]
        },
        "scenarioConfig": {
          "type": "object"
        },
        "enabled": {
          "type": "boolean"
        },
        "baseUrl": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "navigationTimeout": {
          "type": "number"
        },
        "softAssertions": {
          "type": "boolean"
        },
        "beforeValidateActions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "pageActions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "pageAssertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "validations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/validationOrReusable"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "path"
          ]
        },
        {
          "required": [
            "url"
          ]
        },
        {
          "required": [
            "scenario"
          ]
        }
      ]
    },
    "validationTemplateDefinition": {
      "anyOf": [
        {
          "$ref": "#/$defs/validation"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/validation"
          }
        },
        {
          "type": "object",
          "required": [
            "template"
          ],
          "additionalProperties": false,
          "properties": {
            "defaults": {
              "type": "object",
              "additionalProperties": true
            },
            "template": {
              "anyOf": [
                {
                  "$ref": "#/$defs/validation"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/validation"
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "validation": {
      "type": "object",
      "required": [
        "name",
        "locator",
        "assertions"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/locator"
            },
            {
              "type": "string",
              "pattern": "^\\$\\{params?\\.[a-zA-Z0-9_.]+\\}$"
            }
          ]
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/assertion"
          }
        }
      }
    },
    "validationOrReusable": {
      "oneOf": [
        {
          "$ref": "#/$defs/validation"
        },
        {
          "type": "object",
          "required": [
            "$ref"
          ],
          "additionalProperties": false,
          "properties": {
            "$ref": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "$template"
          ],
          "additionalProperties": false,
          "properties": {
            "$template": {
              "type": "string"
            },
            "params": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "locator": {
      "type": "object",
      "required": [
        "strategy"
      ],
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "enum": [
            "id",
            "role",
            "text",
            "label",
            "placeholder",
            "altText",
            "title",
            "testId",
            "css",
            "xpath",
            "locator",
            "custom"
          ]
        },
        "id": {
          "type": "string"
        },
        "selector": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "exact": {
          "type": "boolean"
        },
        "level": {
          "type": [
            "number",
            "string"
          ]
        },
        "testId": {
          "type": "string"
        },
        "hasText": {
          "type": "string"
        },
        "nth": {
          "type": [
            "number",
            "string"
          ]
        },
        "first": {
          "type": "boolean"
        },
        "last": {
          "type": "boolean"
        },
        "locator": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "engine": {
          "enum": [
            "css",
            "xpath",
            "playwright"
          ]
        }
      }
    },
    "action": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "click",
            "fill",
            "check",
            "uncheck",
            "hover",
            "press",
            "selectOption"
          ]
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/locator"
            },
            {
              "type": "string",
              "pattern": "^\\$\\{params?\\.[a-zA-Z0-9_.]+\\}$"
            }
          ]
        },
        "validations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/validationOrReusable"
          }
        },
        "pageActions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        }
      }
    },
    "assertion": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "visible",
            "hidden",
            "attached",
            "enabled",
            "disabled",
            "editable",
            "checked",
            "unchecked",
            "empty",
            "textEquals",
            "textContains",
            "valueEquals",
            "attributeEquals",
            "countEquals",
            "countGreaterThan",
            "classContains",
            "cssEquals",
            "titleEquals",
            "titleContains",
            "urlEquals",
            "urlContains",
            "${param.assertion}"
          ]
        },
        "expected": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "expectedRegex": {
          "type": "string"
        },
        "flags": {
          "type": "string"
        },
        "attributeName": {
          "type": "string"
        },
        "cssName": {
          "type": "string"
        },
        "soft": {
          "type": "boolean"
        },
        "timeout": {
          "type": [
            "number",
            "string"
          ]
        }
      }
    }
  }
}
