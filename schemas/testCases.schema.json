{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data-driven Playwright page validation data",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "imports": {
      "type": "array",
      "description": "Optional list of JSON files to import and merge into this file. Paths are relative to the file that declares the import. Imported testCases are appended in order; shared objects such as tokens, scenarioDefinitions, validationTemplates, and validationSets are merged.",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseUrl": {
          "type": "string"
        },
        "navigationTimeout": {
          "type": "number"
        },
        "softAssertions": {
          "type": "boolean"
        }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "validationTemplates": {
      "type": "object",
      "description": "Parameterized validation definitions. Reuse them with {$template, params} in testCases, validationSets, or action validations.",
      "additionalProperties": {
        "$ref": "#/$defs/validationTemplateDefinition"
      }
    },
    "validationSets": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/validationOrReusable"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/$defs/validationOrReusable"
            }
          }
        ]
      }
    },
    "testCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/pageCase"
      }
    },
    "pages": {
      "type": "array",
      "description": "Legacy alias for testCases. Prefer testCases for new files.",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/pageCase"
      }
    },
    "scenarioDefinitions": {
      "type": "object",
      "description": "Reusable scenario flows executed before each test case. Each key should match a testCases[].scenario value. The flow uses the same config-driven actions/validations as normal tests and can reference scenarioConfig values with ${scenarioConfig.fieldName}.",
      "additionalProperties": {
        "$ref": "#/$defs/scenarioDefinition"
      }
    }
  },
  "$defs": {
    "pageCase": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "scenario": {
          "type": "string",
          "enum": [
            "prompt",
            "template",
            "figma",
            "existingApp"
          ],
          "description": "Name of a reusable scenario flow under scenarioDefinitions. Built-in names used by this project are prompt, template, figma, and existingApp."
        },
        "scenarioConfig": {
          "$ref": "#/$defs/scenarioConfig",
          "description": "Parameters passed into the selected scenarioDefinition. Scenario definitions can reference these values with ${scenarioConfig.fieldName}."
        },
        "enabled": {
          "type": "boolean"
        },
        "baseUrl": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "navigationTimeout": {
          "type": "number"
        },
        "softAssertions": {
          "type": "boolean"
        },
        "beforeValidateActions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "pageActions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "pageAssertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "validations": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/validationOrReusable"
          }
        },
        "includeTestCases": {
          "type": "array",
          "description": "Reuse the configured sections from existing test cases in this test case. Referenced test cases do not rerun their scenario/navigation; only their configured actions/assertions/validations are executed in order.",
          "items": {
            "$ref": "#/$defs/testCaseInclude"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "path"
          ]
        },
        {
          "required": [
            "url"
          ]
        },
        {
          "required": [
            "scenario"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "scenario": {
                "const": "prompt"
              }
            },
            "required": [
              "scenario"
            ]
          },
          "then": {
            "required": [
              "scenarioConfig"
            ],
            "properties": {
              "scenarioConfig": {
                "type": "object",
                "required": [
                  "type",
                  "prompt"
                ],
                "additionalProperties": true,
                "properties": {
                  "type": {
                    "const": "prompt"
                  },
                  "prompt": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scenario": {
                "const": "template"
              }
            },
            "required": [
              "scenario"
            ]
          },
          "then": {
            "required": [
              "scenarioConfig"
            ],
            "properties": {
              "scenarioConfig": {
                "type": "object",
                "required": [
                  "type",
                  "templateName"
                ],
                "additionalProperties": true,
                "properties": {
                  "type": {
                    "const": "template"
                  },
                  "templateName": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scenario": {
                "const": "figma"
              }
            },
            "required": [
              "scenario"
            ]
          },
          "then": {
            "required": [
              "scenarioConfig"
            ],
            "properties": {
              "scenarioConfig": {
                "type": "object",
                "required": [
                  "type",
                  "figmaUrl",
                  "figmaAppName"
                ],
                "additionalProperties": true,
                "properties": {
                  "type": {
                    "const": "figma"
                  },
                  "figmaUrl": {
                    "type": "string"
                  },
                  "figmaAppName": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scenario": {
                "const": "existingApp"
              }
            },
            "required": [
              "scenario"
            ]
          },
          "then": {
            "required": [
              "scenarioConfig"
            ],
            "properties": {
              "scenarioConfig": {
                "type": "object",
                "required": [
                  "type",
                  "appName"
                ],
                "additionalProperties": true,
                "properties": {
                  "type": {
                    "const": "existingApp"
                  },
                  "appName": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "validationTemplateDefinition": {
      "anyOf": [
        {
          "$ref": "#/$defs/validation"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/validation"
          }
        },
        {
          "type": "object",
          "required": [
            "template"
          ],
          "additionalProperties": false,
          "properties": {
            "defaults": {
              "type": "object",
              "additionalProperties": true
            },
            "template": {
              "anyOf": [
                {
                  "$ref": "#/$defs/validation"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/validation"
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "validation": {
      "type": "object",
      "required": [
        "name",
        "locator",
        "assertions"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/locator"
            },
            {
              "type": "string",
              "pattern": "^\\$\\{(?:param|params|tokens)\\.[a-zA-Z0-9_.]+\\}$"
            }
          ]
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/assertion"
          }
        }
      }
    },
    "validationOrReusable": {
      "oneOf": [
        {
          "$ref": "#/$defs/validation"
        },
        {
          "type": "object",
          "required": [
            "$ref"
          ],
          "additionalProperties": false,
          "properties": {
            "$ref": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "$template"
          ],
          "additionalProperties": false,
          "properties": {
            "$template": {
              "type": "string"
            },
            "params": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "locator": {
      "type": "object",
      "required": [
        "strategy"
      ],
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "id",
                "role",
                "text",
                "label",
                "img",
                "placeholder",
                "altText",
                "title",
                "testId",
                "css",
                "xpath",
                "locator",
                "custom"
              ]
            },
            {
              "type": "string",
              "pattern": "^\\$\\{(?:param|params|tokens)\\.[a-zA-Z0-9_.]+\\}$"
            }
          ],
          "description": "Supported runtime locator strategies. A ${param.*} placeholder is allowed inside validationTemplates."
        },
        "id": {
          "type": "string"
        },
        "selector": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "exact": {
          "type": [
            "boolean",
            "string"
          ]
        },
        "level": {
          "type": [
            "number",
            "string"
          ]
        },
        "testId": {
          "type": "string"
        },
        "hasText": {
          "type": "string"
        },
        "nth": {
          "type": [
            "number",
            "string"
          ]
        },
        "first": {
          "type": [
            "boolean",
            "string"
          ]
        },
        "last": {
          "type": [
            "boolean",
            "string"
          ]
        },
        "locator": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "engine": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "css",
                "xpath",
                "playwright"
              ]
            },
            {
              "type": "string",
              "pattern": "^\\$\\{(?:param|params|tokens)\\.[a-zA-Z0-9_.]+\\}$"
            }
          ]
        },
        "timeout": {
          "type": [
            "number",
            "string"
          ]
        },
        "frameLocator": {
          "type": "string",
          "description": "Optional selector for an iframe. When provided, this locator is resolved inside that iframe, e.g. \"#emulator-iframe\" or \"iframe[name=app]\"."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "strategy": {
                "const": "id"
              }
            }
          },
          "then": {
            "required": [
              "id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "strategy": {
                "const": "role"
              }
            }
          },
          "then": {
            "required": [
              "role"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "strategy": {
                "const": "text"
              }
            }
          },
          "then": {
            "required": [
              "text"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "strategy": {
                "const": "label"
              }
            }
          },
          "then": {
            "required": [
              "text"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "strategy": {
                "const": "placeholder"
              }
            }
          },
          "then": {
            "required": [
              "text"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "strategy": {
                "const": "altText"
              }
            }
          },
          "then": {
            "required": [
              "text"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "strategy": {
                "const": "title"
              }
            }
          },
          "then": {
            "required": [
              "text"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "strategy": {
                "const": "testId"
              }
            }
          },
          "then": {
            "required": [
              "testId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "strategy": {
                "const": "css"
              }
            }
          },
          "then": {
            "required": [
              "selector"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "strategy": {
                "const": "xpath"
              }
            }
          },
          "then": {
            "required": [
              "selector"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "strategy": {
                "const": "locator"
              }
            }
          },
          "then": {
            "required": [
              "locator"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "strategy": {
                "const": "img"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "name"
                ]
              },
              {
                "required": [
                  "text"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "strategy": {
                "const": "custom"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "locator"
                ]
              },
              {
                "required": [
                  "selector"
                ]
              },
              {
                "required": [
                  "value"
                ]
              }
            ]
          }
        }
      ]
    },
    "action": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "click",
            "fill",
            "check",
            "uncheck",
            "hover",
            "press",
            "selectOption",
            "download",
            "downloadAppDefinition",
            "downloadCodeFromEmail",
            "connectToGitHub",
            "buildAndRunApp",
            "waitForBuildComplete",
            "openRunOnDeviceModal",
            "waitForQrCodeGenerated",
            "switchToMainPage",
            "switchToRunPage"
          ],
          "description": "Supported configuration-driven action types implemented in tests/data-driven.spec.ts."
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/locator"
            },
            {
              "type": "string",
              "pattern": "^\\$\\{(?:param|params|tokens)\\.[a-zA-Z0-9_.]+\\}$"
            }
          ]
        },
        "validations": {
          "type": "array",
          "description": "Backward-compatible action-level validations. These run immediately after the action finishes.",
          "items": {
            "$ref": "#/$defs/validationOrReusable"
          }
        },
        "postValidations": {
          "type": "array",
          "description": "Preferred action-level validations. These run immediately after the action finishes and before nested pageActions.",
          "items": {
            "$ref": "#/$defs/validationOrReusable"
          }
        },
        "pageActions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "name": {
          "type": "string"
        },
        "expectedExtension": {
          "type": "string"
        },
        "expectedFileNameContains": {
          "type": "string"
        },
        "validateJson": {
          "type": "boolean"
        },
        "minBytes": {
          "type": [
            "number",
            "string"
          ]
        },
        "saveAs": {
          "type": "string"
        },
        "timeout": {
          "type": [
            "number",
            "string"
          ]
        },
        "expectedEmailSubject": {
          "type": "string"
        },
        "emailFrom": {
          "type": "string"
        },
        "emailTo": {
          "type": "string"
        },
        "emailBodyContains": {
          "type": "string"
        },
        "pollIntervalMs": {
          "type": [
            "number",
            "string"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "fill",
                  "press",
                  "selectOption"
                ]
              }
            }
          },
          "then": {
            "required": [
              "value"
            ]
          }
        }
      ]
    },
    "assertion": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "visible",
                "hidden",
                "attached",
                "enabled",
                "disabled",
                "editable",
                "checked",
                "unchecked",
                "empty",
                "textEquals",
                "textContains",
                "valueEquals",
                "attributeEquals",
                "countEquals",
                "countGreaterThan",
                "classContains",
                "cssEquals",
                "titleEquals",
                "titleContains",
                "urlEquals",
                "urlContains"
              ]
            },
            {
              "type": "string",
              "pattern": "^\\$\\{(?:param|params|tokens)\\.[a-zA-Z0-9_.]+\\}$"
            }
          ],
          "description": "Supported locator and page assertion types. A ${param.*} placeholder is allowed inside validationTemplates."
        },
        "expected": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "expectedRegex": {
          "type": "string"
        },
        "flags": {
          "type": "string"
        },
        "attributeName": {
          "type": "string"
        },
        "cssName": {
          "type": "string"
        },
        "soft": {
          "type": "boolean"
        },
        "timeout": {
          "type": [
            "number",
            "string"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "titleEquals",
                  "titleContains",
                  "urlEquals",
                  "urlContains",
                  "textEquals",
                  "textContains",
                  "valueEquals",
                  "attributeEquals",
                  "countEquals",
                  "countGreaterThan",
                  "classContains",
                  "cssEquals"
                ]
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "expected"
                ]
              },
              {
                "required": [
                  "expectedRegex"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "attributeEquals"
              }
            }
          },
          "then": {
            "required": [
              "attributeName"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "cssEquals"
              }
            }
          },
          "then": {
            "required": [
              "cssName"
            ]
          }
        }
      ]
    },
    "testCaseInclude": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "sections": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "enum": [
                  "beforeValidateActions",
                  "pageAssertions",
                  "validations",
                  "pageActions",
                  "includeTestCases"
                ]
              }
            }
          }
        }
      ]
    },
    "scenarioConfig": {
      "description": "Parameters for the selected JSON-defined scenario. The known scenarios use prompt, templateName, figmaUrl/figmaAppName, or appName, but additional properties are allowed for custom scenario definitions.",
      "anyOf": [
        {
          "type": "object",
          "required": [
            "type",
            "prompt"
          ],
          "additionalProperties": true,
          "properties": {
            "type": {
              "const": "prompt"
            },
            "prompt": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "templateName"
          ],
          "additionalProperties": true,
          "properties": {
            "type": {
              "const": "template"
            },
            "templateName": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "figmaUrl",
            "figmaAppName"
          ],
          "additionalProperties": true,
          "properties": {
            "type": {
              "const": "figma"
            },
            "figmaUrl": {
              "type": "string"
            },
            "figmaAppName": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "appName"
          ],
          "additionalProperties": true,
          "properties": {
            "type": {
              "const": "existingApp"
            },
            "appName": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": true
        }
      ]
    },
    "scenarioDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "beforeValidateActions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "pageActions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "pageAssertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "validations": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/validationOrReusable"
          }
        }
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "testCases"
      ]
    },
    {
