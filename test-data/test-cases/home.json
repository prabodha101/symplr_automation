{
  "testCases": [
    {
      "name": "Home page loads correctly",
      "enabled": true,
      "pageAssertions": [
        {
          "type": "titleContains",
          "expected": "${tokens.homePageTitle}"
        },
        {
          "type": "urlContains",
          "expected": "${tokens.dashboardUrlSegment}"
        }
      ],
      "validations": [
        {
          "$template": "headingIsVisibleByText",
          "params": {
            "text": "${tokens.buildAppsHeading}",
            "level": 1
          }
        },
        {
          "$template": "textIsVisible",
          "params": {
            "text": "${tokens.speedText}"
          }
        },
        {
          "$template": "buttonIsVisible",
          "params": {
            "name": "${tokens.importFromFigmaButton}"
          }
        },
        {
          "$template": "buttonIsVisible",
          "params": {
            "name": "${tokens.startBuildingButton}"
          }
        },
        {
          "$template": "assertElementByRole",
          "params": {
            "role": "button",
            "name": "${tokens.startBuildingButton}",
            "assertion": "disabled"
          }
        },
        {
          "$template": "textIsVisible",
          "params": {
            "text": "${tokens.createFromTemplateText}"
          }
        }
      ]
    },
    {
      "name": "Create app using template",
      "enabled": true,
      "beforeValidateActions": [
        {
          "type": "click",
          "name": "Open Create from Template section",
          "locator": {
            "strategy": "locator",
            "locator": "p:has-text(\"Create from Template\")",
            "exact": true
          },
          "validations": [
            {
              "$template": "textIsVisible",
              "params": {
                "text": "Create App"
              }
            }
          ]
        },
        {
          "type": "fill",
          "name": "Search for existing template",
          "locator": {
            "strategy": "locator",
            "locator": "input[name='searchStr']"
          },
          "value": "${tokens.templateName}"
        },
        {
          "type": "click",
          "name": "Open existing template from search result",
          "locator": {
            "strategy": "locator",
            "locator": "div[data-template-id=\"${tokens.templateId}\"]",
            "exact": true,
            "nth": 1
          }
        },
        {
          "type": "click",
          "name": "Click 'Continue'",
          "locator": {
            "strategy": "role",
            "role": "button",
            "name": "Continue",
            "exact": true
          }
        }
      ],
      "validations": [
        {
          "$ref": "storyboardReady"
        },
        {
          "$ref": "blueprintScreen"
        }
      ]
    },
    {
      "name": "Create app using figma",
      "enabled": true,
      "beforeValidateActions": [
        {
          "type": "click",
          "name": "Open Import from Figma dialog",
          "locator": {
            "strategy": "role",
            "role": "button",
            "name": "${tokens.importFromFigmaButton}",
            "exact": true
          }
        },
        {
          "type": "fill",
          "name": "Enter Figma design URL",
          "locator": {
            "strategy": "role",
            "role": "textbox",
            "name": "https://www.figma.com/design/zoxen",
            "exact": true
          },
          "value": "${tokens.figmaUrl}"
        },
        {
          "type": "click",
          "name": "Click Import",
          "locator": {
            "strategy": "role",
            "role": "button",
            "name": "Import",
            "exact": true
          }
        }
      ],
      "validations": [
        {
          "$template": "textIsVisible",
          "params": {
            "text": "Setting Up the App, Hang Tight!",
            "timeout": 30000
          }
        },
        {
          "$ref": "storyboardReady"
        }
      ]
    },
    {
      "name": "Create app using prompt",
      "enabled": true,
      "beforeValidateActions": [
        {
          "type": "fill",
          "name": "Enter app prompt",
          "locator": {
            "strategy": "role",
            "role": "textbox",
            "name": "Write your future app idea",
            "exact": true
          },
          "value": "${tokens.prompt}",
          "validations": [
            {
              "$template": "buttonIsEnabled",
              "params": {
                "name": "${tokens.startBuildingButton}"
              }
            }
          ]
        },
        {
          "type": "waitForTimeout",
          "timeout": 5000
        },
        {
          "type": "click",
          "name": "Click Start Building",
          "locator": {
            "strategy": "role",
            "role": "button",
            "name": "${tokens.startBuildingButton}"
          }
        }
      ],
      "validations": [
        {
          "$ref": "storyboardReady"
        }
      ]
    },
    {
      "name": "Load existing app",
      "enabled": true,
      "beforeValidateActions": [
        {
          "type": "click",
          "name": "Focus app search input",
          "locator": {
            "strategy": "role",
            "role": "textbox",
            "name": "Search",
            "exact": true
          }
        },
        {
          "type": "fill",
          "name": "Search for existing app",
          "locator": {
            "strategy": "role",
            "role": "textbox",
            "name": "Search",
            "exact": true
          },
          "value": "${tokens.appName}"
        },
        {
          "type": "click",
          "name": "Open existing app from search result",
          "locator": {
            "strategy": "text",
            "text": "${tokens.appName}",
            "exact": true,
            "first": true
          }
        }
      ],
      "validations": [
        {
          "$ref": "storyboardReady"
        }
      ]
    }
  ]
}