{
  "testCases": [
    {
      "name": "Validate that code can be sent by email from Developer Options",
      "enabled": true,
      "scenario": "existingApp",
      "scenarioConfig": {
        "type": "existingApp",
        "appName": "${tokens.appName}"
      },
      "beforeValidateActions": [
        {
          "type": "click",
          "locator": {
            "strategy": "locator",
            "locator": "[data-testid^=\"nav-item-\"][aria-label=\"Blueprint\"]",
            "exact": true
          }
        }
      ],
      "validations": [
        {
          "$ref": "appDefinitionValidation"
        }
      ],
      "pageActions": [
        {
          "type": "click",
          "name": "Open Developer Tools menu",
          "locator": {
            "strategy": "locator",
            "locator": "div[aria-label=\"Download App Definition\"] + button"
          },
          "validations": [
            {
              "$template": "textIsVisible",
              "params": {
                "text": "Developer Tools"
              }
            },
            {
              "$template": "buttonIsVisible",
              "params": {
                "name": "Download",
                "exact": false,
                "timeout": 30000
              }
            }
          ]
        },
        {
          "type": "click",
          "name": "Click 'Download' from Developer Tools",
          "locator": {
            "strategy": "role",
            "role": "button",
            "name": "Download",
            "exact": false
          }
        },
        {
          "type": "downloadCodeEmail",
          "name": "Validate download code email and ZIP file",
          "expectedEmailSubject": "Download Code",
          "timeout": 180000,
          "pollIntervalMs": 5000,
          "expectedExtension": ".zip",
          "minBytes": 1
        }
      ]
    }
  ]
}