{
  "testCases": [
    {
      "name": "Fresh Account: Validate that code can be pushed to GitHub from Developer Options",
      "enabled": true,
      "scenario": "existingApp",
      "scenarioConfig": {
        "type": "existingApp",
        "appName": "${tokens.appName}"
      },
      "beforeValidateActions": [
        {
          "type": "click",
          "locator": {
            "strategy": "locator",
            "locator": "[data-testid^=\"nav-item-\"][aria-label=\"Blueprint\"]",
            "exact": true
          }
        }
      ],
      "validations": [
        {
          "$ref": "appDefinitionValidation"
        }
      ],
      "pageActions": [
        {
          "type": "click",
          "locator": {
            "strategy": "locator",
            "locator": "div[aria-label=\"Download App Definition\"] + button"
          },
          "validations": [
            {
              "$template": "textIsVisible",
              "params": {
                "text": "Connect GitHub"
              }
            }
          ]
        },
        {
          "type": "click",
          "locator": {
            "strategy": "role",
            "role": "button",
            "name": "Connect"
          },
          "validations": [
            {
              "$template": "textIsVisible",
              "params": {
                "text": "Connect to GitHub"
              }
            }
          ]
        },
        {
          "type": "click",
          "locator": {
            "strategy": "role",
            "role": "button",
            "name": "Continue"
          },
          "validations": [
            {
              "$template": "textIsVisible",
              "params": {
                "text": "Authorize SymplrStudio"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Validate that code can be pushed to GitHub from Developer Options",
      "enabled": true,
      "scenario": "existingApp",
      "scenarioConfig": {
        "type": "existingApp",
        "appName": "${tokens.appName}"
      },
      "beforeValidateActions": [
        {
          "type": "click",
          "locator": {
            "strategy": "locator",
            "locator": "[data-testid^=\"nav-item-\"][aria-label=\"Blueprint\"]",
            "exact": true
          }
        }
      ],
      "validations": [
        {
          "$ref": "appDefinitionValidation"
        }
      ],
      "pageActions": [
        {
          "type": "connectToGitHub",
          "name": "Connect to GitHub",
          "expectedEmailSubject": "Push Code Github",
          "timeout": 300000,
          "pollIntervalMs": 5000,
          "expectedExtension": ".zip",
          "minBytes": 1
        }
      ]
    }
  ]
}