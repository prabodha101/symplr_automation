{
  "scenarioDefinitions": {
    "prompt": {
      "description": "Create a new app from a text prompt. Change selectors/text here if the prompt flow changes.",
      "beforeValidateActions": [
        {
          "type": "fill",
          "name": "Enter app prompt",
          "locator": {
            "strategy": "role",
            "role": "textbox",
            "name": "Write your future app idea",
            "exact": true
          },
          "value": "${scenarioConfig.prompt}"
        },
        {
          "type": "click",
          "name": "Click Start Building",
          "locator": {
            "strategy": "role",
            "role": "button",
            "name": "${tokens.startBuildingButton}",
            "exact": true
          }
        }
      ],
      "validations": [
        {
          "$ref": "storyboardReady"
        }
      ]
    },
    "figma": {
      "description": "Create a new app by importing Figma screens. Change selectors/text here if the Figma import flow changes.",
      "beforeValidateActions": [
        {
          "type": "click",
          "name": "Open Import from Figma dialog",
          "locator": {
            "strategy": "role",
            "role": "button",
            "name": "${tokens.importFromFigmaButton}",
            "exact": true
          }
        },
        {
          "type": "fill",
          "name": "Enter Figma design URL",
          "locator": {
            "strategy": "role",
            "role": "textbox",
            "name": "https://www.figma.com/design/zoxen",
            "exact": true
          },
          "value": "${scenarioConfig.figmaUrl}"
        },
        {
          "type": "click",
          "name": "Click Import",
          "locator": {
            "strategy": "role",
            "role": "button",
            "name": "Import",
            "exact": true
          }
        }
      ],
      "validations": [
        {
          "$template": "textIsVisible",
          "params": {
            "text": "Setting Up the App, Hang Tight!",
            "timeout": 30000
          }
        },
        {
          "$ref": "storyboardReady"
        }
      ]
    },
    "existingApp": {
      "description": "Open an existing app from the dashboard search results. Change selectors/text here if the search/open flow changes.",
      "beforeValidateActions": [
        {
          "type": "click",
          "name": "Focus app search input",
          "locator": {
            "strategy": "role",
            "role": "textbox",
            "name": "Search",
            "exact": true
          }
        },
        {
          "type": "fill",
          "name": "Search for existing app",
          "locator": {
            "strategy": "role",
            "role": "textbox",
            "name": "Search",
            "exact": true
          },
          "value": "${scenarioConfig.appName}"
        },
        {
          "type": "click",
          "name": "Open existing app from search result",
          "locator": {
            "strategy": "text",
            "text": "${scenarioConfig.appName}",
            "exact": true,
            "first": true
          }
        }
      ],
      "validations": [
        {
          "$ref": "storyboardReady"
        }
      ]
    },
    "template": {
      "description": "Create a new app from a template. This is intentionally JSON-only so update these actions to match the real template UI when needed.",
      "beforeValidateActions": [
        {
          "type": "click",
          "name": "Open Create from Template section",
          "locator": {
            "strategy": "locator",
            "locator": "p:has-text(\"Create from Template\")",
            "exact": true
          },
          "validations": [
            {
              "$template": "textIsVisible",
              "params": {
                "text": "Create App"
              }
            }
          ]
        },
        {
          "type": "fill",
          "name": "Search for existing template",
          "locator": {
            "strategy": "locator",
            "locator": "input[name='searchStr']"
          },
          "value": "pay101V2DemoApp"
        },
        {
          "type": "click",
          "name": "Open existing template from search result",
          "locator": {
            "strategy": "locator",
            "locator": "div[data-template-id=\"${tokens.templateId}\"]",
            "exact": true,
            "nth": 0
          }
        },
        {
          "type": "click",
          "name": "Open existing template from search result",
          "locator": {
            "strategy": "role",
            "role": "button",
            "name": "Continue",
            "exact": true
          }
        }
      ],
      "validations": [
        {
          "$ref": "storyboardReady"
        }
      ]
    }
  }
}