{
  "name": "symplr-config-driven-test",
  "version": "1.0.0",
  "private": true,
  "description": "Data-driven Playwright project for Symplr with reusable parameterized validation templates and custom locator support.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "install:browsers": "playwright install",
    "validate:data": "node scripts/validate-test-data.mjs test-data/symplr_pages.json",
    "gmail:auth": "node scripts/gmail-auth.mjs",
    "lint": "eslint . --ext .ts,.js,.mjs,.cjs",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "dotenv": "^17.4.2",
    "typescript": "^5.8.3",
    "eslint": "^9.25.1",
    "prettier": "^3.5.3",
    "@eslint/js": "^9.39.1",
    "typescript-eslint": "^8.46.3"
  }
}
